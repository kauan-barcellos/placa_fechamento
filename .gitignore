# ==========================================
# KiCad Git Ignore Rules
# ==========================================

# Arquivos temporários, travas e backups
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
*.lck
*.000

# Configurações locais de usuário do KiCad (layout de janelas, zoom, etc.)
*.kicad_prl

# Diretório de backup automático do KiCad
.kicad-backup/

# Relatórios temporários de verificação
/drc/
/erc/
*_drc_violations.json
*.rpt

# Arquivos do Sistema Operacional
Thumbs.db
Desktop.ini
.DS_Store

# ==========================================
# Manter explicitamente arquivos essenciais
# ==========================================
!*.kicad_pro
!*.kicad_sch
!*.kicad_pcb
!*.kicad_dru
!GEMINI.md
!AGENTS.md
!README.md
!PROJECT_MEMORY.md
!**/.gitkeep
